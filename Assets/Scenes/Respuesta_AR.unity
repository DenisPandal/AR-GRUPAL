    keyObject: {fileID: 738292809}
    alertRenderer: {fileID: 738292806}
    investigateBeacon: {fileID: 7846891931968242228}
    introLines:
    - speaker: "ATAQUE 2016 \xB7 S\xC1B 6"
      text: "S\xE1bado 6. Al intentar reiniciar el sistema aparece en el monitor:
