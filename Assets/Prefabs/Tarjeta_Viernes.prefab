  m_Name: 
  m_EditorClassIdentifier: 
  objectTitle: Hugo Benavides
  evidenceId: Testimonio_Hugo_Viernes
  isKeyObject: 1
  firstPersonInspectionMessage: "Hablas con Hugo Benavides: 'Jefe, pens\xE9 que era
    una falla com\xFAn de la impresora y no quise molestar...'. \xA1T\xF3calo de
    nuevo para asignarle su rol en el Plan de Respuesta!"
  firstPersonResolvedMessage: "Asignaste a Hugo Benavides el protocolo de verificaci\xF3n
    y reporte inmediato de anomal\xEDas en el Viernes."
  attackInspectionMessage: "Hugo Benavides est\xE1 frente a la impresora apagada.
    Al no contar con un plan de roles, decide esperar hasta el lunes para revisarla."
  defenseInspectionMessage: Hugo Benavides recibe el protocolo de roles y notifica
    de inmediato al equipo de seguridad para frenar cualquier salida de fondos.
  associatedDefenseIndex: 0
  suggestedResponsible: Hugo Benavides
  statusRenderer: {fileID: 1390227947211504371}
  resolvedColor: {r: 0.18, g: 0.85, b: 0.45, a: 1}
